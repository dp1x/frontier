*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors
.idea/
.vscode/
*.swp

# Scratch / ramdisk leftovers (never commit)
scratch/
.scratch/
R:/
r:/

# Local env
.env
.env.*
!.env.example

# Caches, corpora, build products
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.whl
*.tar.gz
node_modules/
target/
.cache/
.tox/
.nox/

# Large logs and fuzz corpora
*.log
# Allow build-output logs that are durable research evidence
!formal/build_output*.log
!interop/**/reports/*_console.log
corpus/
fuzz-out/
crash-*

# Security-sensitive local-only artifacts
knowledge/findings/embargoed/*.yaml
knowledge/findings/embargoed/*.md
!knowledge/findings/embargoed/README.md
missions/embargoed/*.yaml
!missions/embargoed/README.md

# Worktrees
.worktrees/

# ALIAS-DIFF generated programs (derivable from gen_programs.py)
compilers/alias-diff/generated/

# Lean 4 / lake build artifacts
formal/.lake/
formal/lake-manifest.json
formal/build/lib/

# Deliberately excluded raw material (decision recorded in rpt-2026-0015 and
# rpt-2026-0018). These are NOT research artifacts:
#   .freebuff/                        - a single project-id UUID from a tool
#   ai-io/pycose_deterministic_cbor/  - raw Qwen transcript material
# Leaving them merely untracked meant a `git add -A` would silently ingest
# them, so the decision is now enforced by .gitignore rather than by care.
.freebuff/
ai-io/pycose_deterministic_cbor/

# Planning / checkpoint files (never commit)
CHECKPOINT.md
BLUEPRINT.md
temp/
