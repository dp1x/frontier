#!/bin/sh
# pre-push identity + signature gate (installed 2026-09-14).
#
# Background: agents used to run `git -c user.email="frontier@local" ... commit`,
# producing 41 commits GitHub showed as "Unverified" (reason: no_user). This
# hook makes a repeat impossible: every commit being pushed must be authored
# AND committed as Dhanesh <dhaneshpanjnani@gmail.com> AND GPG-signed (G).
# Single-pass implementation: one rev-list + one log per pushed ref (~2 s).
# Never bypass with --no-verify (see AGENTS.md Git rules).

ALLOWED_EMAIL="dhaneshpanjnani@gmail.com"
ZERO="0000000000000000000000000000000000000000"
rc=0

while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # branch deletion
    if [ "$remote_sha" = "$ZERO" ]; then
        range="$local_sha"
    else
        range="$local_sha --not $remote_sha"
    fi
    revs=$(git rev-list $range) || exit 1
    [ -z "$revs" ] && continue
    bad=$(printf '%s\n' "$revs" \
        | git log --no-walk --stdin --format='%H %ae %ce %G?' \
        | awk -v ok="$ALLOWED_EMAIL" '
            $2 != ok || $3 != ok || $4 != "G" {
                printf "pre-push: REJECT %s author=%s committer=%s sig=%s\n", $1, $2, $3, $4
            }')
    if [ -n "$bad" ]; then
        printf '%s\n' "$bad" >&2
        rc=1
    fi
done

exit $rc