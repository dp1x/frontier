{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission.schema.json",
  "title": "Frontier mission",
  "type": "object",
  "required": ["id", "type", "status", "created_at", "updated_at", "summary",
               "epistemic_status", "provenance", "links", "title", "objective",
               "domain", "scope", "constraints", "desired_evidence_level",
               "candidate_targets", "dependencies", "compute", "budget",
               "acceptance_criteria", "stopping_conditions"],
  "properties": {
    "id": {"type": "string", "pattern": "^msn-[0-9]{4}-[0-9]{4}$"},
    "type": {"const": "mission"},
    "status": {
      "enum": ["pending", "active", "verified", "disproved",
               "inconclusive-after-budget", "blocked-by-missing-evidence",
               "superseded", "abandoned-with-reason",
               "escalate/security-sensitive"]
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "epistemic_status": {"enum": ["idea", "assumption", "hypothesis",
                                   "observation", "interpretation",
                                   "verified_conclusion"]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "links": {"type": "object"},
    "title": {"type": "string", "minLength": 3},
    "objective": {"type": "string", "minLength": 10},
    "domain": {"enum": ["cryptography", "compilers", "formal", "interop"]},
    "scope": {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "desired_evidence_level": {
      "enum": ["analysis-only", "reproduced", "independently-reviewed",
               "verified"]
    },
    "candidate_targets": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "compute": {
      "type": "object",
      "required": ["expected_class"],
      "properties": {
        "expected_class": {"enum": ["lightweight", "medium", "heavy"]},
        "notes": {"type": "string"}
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_attempts", "max_independent_reviews",
                    "max_compute_runs", "diminishing_returns_window",
                    "max_auto_descendants"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_independent_reviews": {"type": "integer", "minimum": 0},
        "max_compute_runs": {"type": "integer", "minimum": 1},
        "diminishing_returns_window": {"type": "integer", "minimum": 1},
        "max_auto_descendants": {"type": "integer", "minimum": 0}
      }
    },
    "acceptance_criteria": {"type": "array", "minItems": 1,
                             "items": {"type": "string"}},
    "stopping_conditions": {"type": "array", "minItems": 1,
                             "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "follow_ups": {"type": "array", "items": {"type": "string"}},
    "notes_path": {"type": ["string", "null"]},
    "blocked_reason": {"type": ["string", "null"]},
    "terminal_reason": {"type": ["string", "null"]}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["created_by", "sources"],
      "properties": {
        "created_by": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["human", "model-agent", "deterministic-tool"]},
            "role": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]},
            "tool": {"type": ["string", "null"]}
          }
        },
        "sources": {"type": "array"},
        "parent": {"type": ["string", "null"]},
        "generation": {"type": "integer", "minimum": 0}
      }
    }
  }
}
