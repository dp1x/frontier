{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification.schema.json",
  "title": "Frontier verification (deterministic judgment)",
  "type": "object",
  "required": ["id", "type", "status", "created_at", "updated_at", "summary",
               "epistemic_status", "provenance", "links", "method", "result",
               "environment"],
  "properties": {
    "id": {"type": "string", "pattern": "^vrf-[0-9]{4}-[0-9]{4}$"},
    "type": {"const": "verification"},
    "status": {"enum": ["pass", "fail", "inconclusive"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "epistemic_status": {"enum": ["idea", "assumption", "hypothesis",
                                   "observation", "interpretation",
                                   "verified_conclusion"]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "links": {"type": "object"},
    "method": {"enum": ["executable", "formal-verifier", "differential",
                         "deterministic-script", "reproduction"]},
    "result": {"type": "string"},
    "command": {"type": ["string", "null"]},
    "environment": {"type": "object"}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["created_by", "sources"],
      "properties": {
        "created_by": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["human", "model-agent", "deterministic-tool"]},
            "role": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]},
            "tool": {"type": ["string", "null"]}
          }
        },
        "sources": {"type": "array"},
        "parent": {"type": ["string", "null"]},
        "generation": {"type": "integer", "minimum": 0}
      }
    }
  }
}
