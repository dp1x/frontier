{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reproducer.schema.json",
  "title": "Frontier reproducer",
  "type": "object",
  "required": ["id", "type", "status", "created_at", "updated_at", "summary",
               "epistemic_status", "provenance", "links", "path",
               "reproduction_commands"],
  "properties": {
    "id": {"type": "string", "pattern": "^rpr-[0-9]{4}-[0-9]{4}$"},
    "type": {"const": "reproducer"},
    "status": {"enum": ["draft", "reproduced", "failed-to-reproduce",
                         "invalid"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "epistemic_status": {"enum": ["idea", "assumption", "hypothesis",
                                   "observation", "interpretation",
                                   "verified_conclusion"]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "links": {"type": "object"},
    "supersedes": {"$ref": "#/$defs/supersedes"},
    "path": {"type": "string"},
    "reproduction_commands": {"type": "array", "minItems": 1,
                               "items": {"type": "string"}},
    "reproduced_on": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "supersedes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "corrects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(tgt|spc|imp|hyp|exp|obs|rpr|rev|vrf|fnd|cnj|prf|msn|rpt)-[0-9]{4}-[0-9]{4}$"
          },
          "description": "Targets whose wording, scope, locator or count was wrong. Part of the target survives, so the target's status is unchanged."
        },
        "withdraws": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(tgt|spc|imp|hyp|exp|obs|rpr|rev|vrf|fnd|cnj|prf|msn|rpt)-[0-9]{4}-[0-9]{4}$"
          },
          "description": "Targets whose claim is dead: the target's status is withdrawn, rejected or superseded and none of its substance carries."
        },
        "replaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(tgt|spc|imp|hyp|exp|obs|rpr|rev|vrf|fnd|cnj|prf|msn|rpt)-[0-9]{4}-[0-9]{4}$"
          },
          "description": "Targets whose subject this artifact takes over wholesale. The target's status is superseded and this artifact is its successor."
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_by", "sources"],
      "properties": {
        "created_by": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["human", "model-agent", "deterministic-tool"]},
            "role": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]},
            "tool": {"type": ["string", "null"]}
          }
        },
        "sources": {"type": "array"},
        "parent": {"type": ["string", "null"]},
        "generation": {"type": "integer", "minimum": 0}
      }
    }
  }
}
