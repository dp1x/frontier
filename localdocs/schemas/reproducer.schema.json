{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reproducer.schema.json",
  "title": "Frontier reproducer",
  "type": "object",
  "required": ["id", "type", "status", "created_at", "updated_at", "summary",
               "epistemic_status", "provenance", "links", "path",
               "reproduction_commands"],
  "properties": {
    "id": {"type": "string", "pattern": "^rpr-[0-9]{4}-[0-9]{4}$"},
    "type": {"const": "reproducer"},
    "status": {"enum": ["draft", "reproduced", "failed-to-reproduce",
                         "invalid"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "epistemic_status": {"enum": ["idea", "assumption", "hypothesis",
                                   "observation", "interpretation",
                                   "verified_conclusion"]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "links": {"type": "object"},
    "path": {"type": "string"},
    "reproduction_commands": {"type": "array", "minItems": 1,
                               "items": {"type": "string"}},
    "reproduced_on": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["created_by", "sources"],
      "properties": {
        "created_by": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["human", "model-agent", "deterministic-tool"]},
            "role": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]},
            "tool": {"type": ["string", "null"]}
          }
        },
        "sources": {"type": "array"},
        "parent": {"type": ["string", "null"]},
        "generation": {"type": "integer", "minimum": 0}
      }
    }
  }
}
